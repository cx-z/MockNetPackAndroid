<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SDK 连接层（注册/心跳/流量上传/规则拉取）需要网络；随 AAR 合并进宿主 Debug 包。
         拦截、Mock 在应用进程内完成，不申请代理/VPN/证书相关权限。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- AN-4 扫码连接：相机权限由 SDK 在运行时请求（CameraX + ML Kit barcode）。
         权限声明随 AAR 合并进宿主 Debug 包；外网包不引入 SDK ⇒ CAMERA 权限不进发布包（§8.3）。 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <application>
        <!-- AN-4 扫码界面（CameraX PreviewView + ML Kit barcode）。由 SDK 内部启动，
             宿主无需直接引用；exported=false（不对外部应用开放）。 -->
        <activity
            android:name="com.mocknetpack.android.internal.scan.QRScannerActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    </application>

</manifest>
